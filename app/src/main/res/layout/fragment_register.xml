<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/registerFragment"
    android:background="#121d1e"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".RegisterFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >


            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/img"
                android:contentDescription="@string/app_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"


                />

            <TextView
                android:id="@+id/Appconnect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="App Connect!"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_margin="20dp"
                app:layout_constraintTop_toBottomOf="@id/img_logo"/>
            <TextView
                android:id="@+id/Welcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Welcome Back!"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_margin="20dp"
                app:layout_constraintTop_toBottomOf="@id/Appconnect"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etEmaillayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Email"
                app:startIconDrawable="@drawable/baseline_person_outline_24"

                app:layout_constraintTop_toBottomOf="@id/Welcome"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/Email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etUsernameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Username"
                app:startIconDrawable="@drawable/baseline_person_outline_24"

                app:layout_constraintTop_toBottomOf="@+id/etEmaillayout"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etPwdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Password"
                app:startIconDrawable="@drawable/baseline_lock_24"
                app:endIconDrawable="@drawable/baseline_remove_red_eye_24"
                app:endIconMode="password_toggle"

                app:layout_constraintTop_toBottomOf="@id/etUsernameLayout"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etCpasswordlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:hint="Comfrim Password"
                app:startIconDrawable="@drawable/baseline_vpn_key_24"
                app:endIconDrawable="@drawable/baseline_remove_red_eye_24"
                app:endIconMode="password_toggle"

                app:layout_constraintTop_toBottomOf="@id/etPwdLayout"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCpassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:ellipsize="end"
                    />
            </com.google.android.material.textfield.TextInputLayout>




            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Register"
                android:textSize="25sp"
                android:textColor="#FFFFFF"
                android:layout_margin="20dp"
                android:background="#00bfa5"
                app:backgroundTint="@null"
                android:enabled="false"

                app:layout_constraintTop_toBottomOf="@id/etCpasswordlayout"
                />



            <TextView
                android:id="@+id/OrLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="-----or login with------"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="20dp"
                android:layout_margin="20dp"
                android:textAlignment="center"

                app:layout_constraintTop_toBottomOf="@id/btnRegister"

                />
            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="28dp"
                android:background="#121d1e"

                android:src="@drawable/facebook"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/OrLog" />

            <ImageView
                android:id="@+id/btngoogle"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/google"
                android:background="#121d1e"

                app:layout_constraintTop_toTopOf="@id/btnFacebook"
                app:layout_constraintStart_toEndOf="@id/btnFacebook"
                android:layout_marginStart="50dp"
                />

            <ImageView
                android:id="@+id/github"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="#121d1e"

                android:src="@drawable/github"
                app:layout_constraintTop_toTopOf="@id/btngoogle"
                app:layout_constraintStart_toEndOf="@id/btngoogle"
                android:layout_marginStart="50dp" />
            <TextView
                android:id="@+id/tvDontHaveAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have account?"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20dp"
                app:layout_constraintStart_toStartOf="@id/btnFacebook"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnFacebook"

                app:layout_constraintHorizontal_chainStyle="packed"/>
            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textColor="#00bfa5"
                android:textStyle="bold"
                android:textSize="20dp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvDontHaveAccount"
                app:layout_constraintStart_toEndOf="@id/tvDontHaveAccount"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>